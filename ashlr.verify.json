{
  "schemaVersion": 1,
  "mode": "replace-detected",
  "authorityFiles": [
    "package.json",
    "package-lock.json",
    "tsconfig.json",
    "eslint.config.js",
    "vitest.config.ts",
    "test/setup/home.ts",
    "scripts/test-ci.mjs",
    "scripts/copy-assets.mjs",
    "scripts/build-identity.mjs",
    "scripts/run-bounded-command.mjs",
    "scripts/run-local-production-gate.mjs",
    "scripts/run-local-pack-smoke.mjs",
    "scripts/verify-local-production-gate-receipt.mjs",
    "scripts/verify-release-policy.mjs",
    "scripts/npm-audit-with-osv-fallback.sh",
    "src/raycast/package.json",
    "src/raycast/package-lock.json",
    "desktop/src-tauri/Cargo.toml",
    "desktop/src-tauri/Cargo.lock",
    "desktop/src-tauri/build.rs",
    "desktop/src-tauri/tauri.conf.json",
    "docs/contracts/CONTRACT-M571.md"
  ],
  "commands": [
    {
      "id": "typecheck",
      "kind": "typecheck",
      "cmd": ["npm", "run", "typecheck"],
      "cwd": ".",
      "timeoutMs": 180000,
      "required": true,
      "profiles": ["quick", "merge", "deep"]
    },
    {
      "id": "lint",
      "kind": "lint",
      "cmd": ["npm", "run", "lint"],
      "cwd": ".",
      "timeoutMs": 300000,
      "required": true,
      "profiles": ["merge", "deep"]
    },
    {
      "id": "build",
      "kind": "build",
      "cmd": ["npm", "run", "build"],
      "cwd": ".",
      "timeoutMs": 300000,
      "required": true,
      "profiles": ["merge", "deep"]
    },
    {
      "id": "test-ci-1-of-3",
      "kind": "test",
      "cmd": ["npm", "run", "test:ci", "--", "--shard=1/3"],
      "cwd": ".",
      "timeoutMs": 600000,
      "required": true,
      "profiles": ["merge", "deep"]
    },
    {
      "id": "test-ci-2-of-3",
      "kind": "test",
      "cmd": ["npm", "run", "test:ci", "--", "--shard=2/3"],
      "cwd": ".",
      "timeoutMs": 600000,
      "required": true,
      "profiles": ["merge", "deep"]
    },
    {
      "id": "test-ci-3-of-3",
      "kind": "test",
      "cmd": ["npm", "run", "test:ci", "--", "--shard=3/3"],
      "cwd": ".",
      "timeoutMs": 600000,
      "required": true,
      "profiles": ["merge", "deep"]
    }
  ],
  "localProductionGate": {
    "schemaVersion": 1,
    "runner": "scripts/run-local-production-gate.mjs",
    "receiptVerifier": "scripts/verify-local-production-gate-receipt.mjs",
    "receiptSchemaVersion": 1,
    "gates": [
      {
        "id": "typecheck",
        "cmd": ["npm", "run", "typecheck"],
        "cwd": ".",
        "timeoutMs": 300000
      },
      {
        "id": "lint",
        "cmd": ["npm", "run", "lint"],
        "cwd": ".",
        "timeoutMs": 300000
      },
      {
        "id": "build",
        "cmd": ["npm", "run", "build"],
        "cwd": ".",
        "timeoutMs": 600000
      },
      {
        "id": "test-ci-1-of-3",
        "cmd": ["npm", "run", "test:ci", "--", "--shard=1/3"],
        "cwd": ".",
        "timeoutMs": 1200000
      },
      {
        "id": "test-ci-2-of-3",
        "cmd": ["npm", "run", "test:ci", "--", "--shard=2/3"],
        "cwd": ".",
        "timeoutMs": 1200000
      },
      {
        "id": "test-ci-3-of-3",
        "cmd": ["npm", "run", "test:ci", "--", "--shard=3/3"],
        "cwd": ".",
        "timeoutMs": 1200000
      },
      {
        "id": "test-web",
        "cmd": ["npm", "run", "test:web"],
        "cwd": ".",
        "timeoutMs": 600000
      },
      {
        "id": "audit-root-full",
        "cmd": ["bash", "scripts/npm-audit-with-osv-fallback.sh", "root full graph", "package-lock.json"],
        "cwd": ".",
        "timeoutMs": 300000
      },
      {
        "id": "audit-root-production",
        "cmd": ["bash", "scripts/npm-audit-with-osv-fallback.sh", "root production graph", "package-lock.json", "--omit=dev"],
        "cwd": ".",
        "timeoutMs": 300000
      },
      {
        "id": "audit-raycast-full",
        "cmd": ["bash", "../../scripts/npm-audit-with-osv-fallback.sh", "Raycast full graph", "package-lock.json"],
        "cwd": "src/raycast",
        "timeoutMs": 300000
      },
      {
        "id": "audit-raycast-production",
        "cmd": ["bash", "../../scripts/npm-audit-with-osv-fallback.sh", "Raycast production graph", "package-lock.json", "--omit=dev"],
        "cwd": "src/raycast",
        "timeoutMs": 300000
      },
      {
        "id": "pack-smoke",
        "cmd": ["node", "scripts/run-local-pack-smoke.mjs", "--repo", "{repo}", "--work-dir", "{temp}/pack-smoke", "--output", "{temp}/pack-evidence.json"],
        "cwd": ".",
        "timeoutMs": 600000
      },
      {
        "id": "native-fmt",
        "cmd": ["cargo", "fmt", "--check"],
        "cwd": "desktop/src-tauri",
        "timeoutMs": 300000
      },
      {
        "id": "native-check",
        "cmd": ["cargo", "check", "--locked", "--all-targets"],
        "cwd": "desktop/src-tauri",
        "timeoutMs": 1200000
      },
      {
        "id": "native-clippy",
        "cmd": ["cargo", "clippy", "--locked", "--all-targets", "--", "-D", "warnings"],
        "cwd": "desktop/src-tauri",
        "timeoutMs": 1200000
      },
      {
        "id": "native-test",
        "cmd": ["cargo", "test", "--locked"],
        "cwd": "desktop/src-tauri",
        "timeoutMs": 1200000
      },
      {
        "id": "native-audit",
        "cmd": ["cargo-audit", "audit", "--file", "Cargo.lock", "--ignore", "RUSTSEC-2024-0429"],
        "cwd": "desktop/src-tauri",
        "timeoutMs": 600000
      }
    ]
  }
}
