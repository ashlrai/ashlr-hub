{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phantom",
  "version": "3.29.1",
  "identifier": "ai.ashlr.desktop",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://127.0.0.1:7777/verse/",
    "beforeBuildCommand": "",
    "beforeBundleCommand": "node scripts/assert-desktop-bundle-policy.mjs && node scripts/dmg-preflight.mjs",
    "frontendDist": "../dist-placeholder"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Phantom",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": false,
        "url": "http://127.0.0.1:7777/verse/?v=3.29.1",
        "visible": false,
        "create": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "backgroundThrottling": "disabled"
      },
      {
        "label": "launch",
        "title": "Phantom",
        "width": 480,
        "height": 300,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "center": true,
        "url": "index.html",
        "visible": false,
        "create": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:7777; connect-src http://127.0.0.1:7777 ws://127.0.0.1:7777; script-src 'self' 'unsafe-inline' http://127.0.0.1:7777; style-src 'self' 'unsafe-inline' http://127.0.0.1:7777; img-src 'self' data: http://127.0.0.1:7777; font-src 'self' http://127.0.0.1:7777"
    },
    "trayIcon": {
      "iconPath": "icons/tray.png",
      "iconAsTemplate": true,
      "tooltip": "Phantom"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Phantom \u2014 local operator console for Claude, Codex, Grok and Ollama seats",
    "longDescription": "Phantom by AshlrAI is a local-first engineering agent workbench. This desktop app starts the bundled ashlr sidecar in Verse mode, hands the window its per-process read and mutation tokens, and shows the Verse operator console at http://127.0.0.1:7777/verse/ with a system tray icon for quick access.",
    "copyright": "Copyright \u00a9 2024 Mason Wyatt / Evero Consulting",
    "category": "DeveloperTool",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": null,
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "linux": {
      "deb": {
        "depends": [],
        "section": "devel"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "externalBin": [
      "binaries/ashlr"
    ],
    "resources": {
      "resources/public": "public"
    }
  },
  "plugins": {
    "shell": {
      "open": false
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/ashlrai/phantom/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFBNDI1NEZGRjRDODVCOEIKUldTTFc4ajAvMVJDcW1MQy84cHNXNUtPYTNDM0s1K2tDc1A2VUxCL1JwWHQzQzl6M3JqQ3I3SmwK"
    }
  }
}
