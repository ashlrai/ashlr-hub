{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ashlr",
  "version": "0.1.0",
  "identifier": "ai.ashlr.desktop",

  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://127.0.0.1:7777/verse/",
    "beforeBuildCommand": "",
    "beforeBundleCommand": "node scripts/assert-desktop-bundle-policy.mjs && node scripts/dmg-preflight.mjs",
    "frontendDist": "../dist-placeholder"
  },

  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ashlr Verse",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": false,
        "url": "http://127.0.0.1:7777/verse/",
        "visible": false,
        "create": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "backgroundThrottling": "disabled"
      },
      {
        "label": "launch",
        "title": "Ashlr",
        "width": 480,
        "height": 300,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "center": true,
        "url": "index.html",
        "visible": false,
        "create": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:7777; connect-src http://127.0.0.1:7777 ws://127.0.0.1:7777; script-src 'self' 'unsafe-inline' http://127.0.0.1:7777; style-src 'self' 'unsafe-inline' http://127.0.0.1:7777; img-src 'self' data: http://127.0.0.1:7777; font-src 'self' http://127.0.0.1:7777"
    },
    "trayIcon": {
      "iconPath": "icons/tray.png",
      "iconAsTemplate": true,
      "tooltip": "Ashlr"
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Ashlr Verse — local operator console for Claude, Codex, Grok and Ollama seats",
    "longDescription": "Ashlr is a local-first autonomous engineering platform. This desktop app starts the bundled ashlr sidecar in Verse mode, hands the window its per-process read and mutation tokens, and shows the Verse operator console at http://127.0.0.1:7777/verse/ with a system tray icon for quick access.",
    "copyright": "Copyright © 2024 Mason Wyatt / Evero Consulting",
    "category": "DeveloperTool",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": null,
      "entitlements": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "linux": {
      "deb": {
        "depends": [],
        "section": "devel"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "externalBin": [
      "binaries/ashlr"
    ],
    "resources": {
      "resources/public": "public"
    }
  },

  "plugins": {
    "shell": {
      "open": false
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/ashlrai/ashlr-hub/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "PLACEHOLDER — replace with the output of `cargo tauri signer generate` (the public key line). See desktop/README.md for instructions. Build succeeds with this placeholder; auto-update is inert until a real key + matching TAURI_SIGNING_PRIVATE_KEY secret are configured."
    }
  }
}
