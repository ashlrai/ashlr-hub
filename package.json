{
  "name": "@ashlr/hub",
  "version": "3.3.2",
  "description": "Local-first command center for agentic engineers.",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT",
  "author": "Mason Wyatt <mason@evero-consulting.com>",
  "homepage": "https://github.com/ashlrai/ashlr-hub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashlrai/ashlr-hub.git"
  },
  "bugs": {
    "url": "https://github.com/ashlrai/ashlr-hub/issues"
  },
  "keywords": [
    "cli",
    "agentic",
    "mcp",
    "local-first",
    "raycast",
    "developer-tools",
    "ai"
  ],
  "type": "module",
  "bin": {
    "ashlr": "bin/ashlr"
  },
  "files": [
    "dist",
    "bin",
    "scripts/run-verify-command.mjs",
    "scripts/scorecard-history-worker.mjs",
    "schema",
    "CHANGELOG.md",
    "docs/MISSION-OS.md",
    "docs/ELITE-AGENT-EFFICIENCY.md",
    "docs/RUNTIME_ACTIVATION_AUTHORITY.md",
    "docs/contracts/CONTRACT-M515.md",
    "docs/contracts/CONTRACT-M521.md",
    "docs/contracts/CONTRACT-MISSION-RECEIPT-V1.md"
  ],
  "bundledDependencies": [
    "@modelcontextprotocol/sdk",
    "marked"
  ],
  "exports": {
    ".": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.js"
    },
    "./core": {
      "types": "./dist/api/core.d.ts",
      "import": "./dist/api/core.js"
    },
    "./types": {
      "types": "./dist/api/types.d.ts",
      "import": "./dist/api/types.js"
    },
    "./plugin": {
      "types": "./dist/api/plugin.d.ts",
      "import": "./dist/api/plugin.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test:ci && npm run test:web",
    "prepack": "npm run build",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs && vite build --config vite.config.web.ts && node scripts/build-release-dependency-inventory.mjs && node scripts/build-identity.mjs",
    "build:binary": "node scripts/build-sea.mjs",
    "release:canary": "node scripts/run-signed-release-canary.mjs",
    "build:web": "vite build --config vite.config.web.ts",
    "dev": "tsx src/cli/index.ts",
    "dev:web": "vite --config vite.config.web.ts",
    "test": "vitest run",
    "test:serial": "vitest run --no-file-parallelism",
    "test:web": "vitest run --config vitest.config.web.ts",
    "test:ci": "node scripts/test-ci.mjs",
    "test:invariants": "vitest run test/h*.test.ts --no-file-parallelism",
    "conformance:ecosystem": "tsx scripts/run-ecosystem-conformance.ts",
    "lint": "eslint . && npm run lint:realio-lane",
    "lint:realio-lane": "node scripts/check-realio-lane-membership.mjs",
    "typecheck": "tsc --noEmit && npm run typecheck:web",
    "typecheck:web": "tsc --noEmit -p src/web-ui/tsconfig.json"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.61.0",
    "vite": "6.4.3",
    "vitest": "4.1.10",
    "yaml": "^2.8.1"
  },
  "overrides": {
    "fast-uri": "3.1.6",
    "hono": "4.12.34",
    "ip-address": "10.4.0",
    "vite": "6.4.3",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "qs": "6.16.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "marked": "17.0.0"
  }
}
