{
  "name": "@ashlr/hub",
  "version": "3.24.3",
  "description": "Phantom by AshlrAI: the open-source engineering agent workbench for CLI accounts, local models and autonomous fleets.",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Mason Wyatt <mason@evero-consulting.com>",
  "homepage": "https://github.com/ashlrai/ashlr-hub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashlrai/ashlr-hub.git"
  },
  "bugs": {
    "url": "https://github.com/ashlrai/ashlr-hub/issues"
  },
  "keywords": [
    "cli",
    "agentic",
    "phantom",
    "coding-agents",
    "agent-orchestration",
    "mcp",
    "local-first",
    "raycast",
    "developer-tools",
    "ai"
  ],
  "type": "module",
  "bin": {
    "ashlr": "bin/ashlr"
  },
  "files": [
    "dist",
    "bin",
    "scripts/run-verify-command.mjs",
    "scripts/scorecard-history-worker.mjs",
    "scripts/evaluators/preparation-verification-activity.mjs",
    "scripts/evaluators/preparation-verification-activity.d.mts",
    "scripts/evaluators/preparation-verification-protocol.mjs",
    "scripts/evaluators/preparation-verification-native.mjs",
    "scripts/evaluators/preparation-verification-native.d.mts",
    "schema",
    "CHANGELOG.md",
    "docs/README.md",
    "docs/PHANTOM-BRAND.md",
    "docs/QUICKSTART.md",
    "docs/AUTOMATIC-OUTCOMES.md",
    "docs/VERSE.md",
    "docs/AUTONOMY-SETUP.md",
    "docs/RESIDENT-RUNTIME.md",
    "docs/AUTHORITY.md",
    "docs/STANDING-AUTHORITY.md",
    "docs/CLOUD.md",
    "docs/LEADER.md",
    "docs/DEVIN.md",
    "docs/VERSE-CONTEXT.md",
    "docs/VERSE-BROWSER.md",
    "docs/JEV-INTEGRATION.md",
    "docs/DEMO.md",
    "docs/ARCHITECTURE.md",
    "docs/MISSION-OS.md",
    "docs/ASHLR-UNIVERSE.md",
    "docs/AUTONOMY-GAP.md",
    "docs/FIRM-DEMO.md",
    "docs/UNIVERSE-RESEARCH.md",
    "docs/UNIVERSE-AUTONOMY-RESEARCH.md",
    "docs/RESOURCE-POOLS.md",
    "docs/NORTH-STAR.md",
    "docs/ELITE-AGENT-EFFICIENCY.md",
    "docs/OPENAI-AGENTS-INTEGRATION.md",
    "docs/DOTS-COMPANION.md",
    "docs/AGENT-HARNESS-EVOLUTION.md",
    "docs/RESET-AWARE-SCHEDULING.md",
    "docs/EXECUTION-FEEDBACK.md",
    "docs/RESOURCE-EVIDENCE.md",
    "docs/RUNTIME_ACTIVATION_AUTHORITY.md",
    "docs/REMOTE-PHONE.md",
    "docs/contracts/CONTRACT-M515.md",
    "docs/contracts/CONTRACT-M521.md",
    "docs/contracts/CONTRACT-M568.md",
    "docs/contracts/CONTRACT-MISSION-RECEIPT-V1.md"
  ],
  "bundledDependencies": [
    "@modelcontextprotocol/sdk",
    "@simplewebauthn/browser",
    "@simplewebauthn/server",
    "jose",
    "marked",
    "reflect-metadata",
    "smol-toml",
    "tar",
    "web-push",
    "yaml"
  ],
  "exports": {
    ".": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.js"
    },
    "./core": {
      "types": "./dist/api/core.d.ts",
      "import": "./dist/api/core.js"
    },
    "./types": {
      "types": "./dist/api/types.d.ts",
      "import": "./dist/api/types.js"
    },
    "./plugin": {
      "types": "./dist/api/plugin.d.ts",
      "import": "./dist/api/plugin.js"
    },
    "./universe": {
      "types": "./dist/core/universe/index.d.ts",
      "import": "./dist/core/universe/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "prepublishOnly": "npm run build && npm run check:first-paint:built && npm run check:docs && npm run typecheck && npm run lint && npm run test:web && npm run test:ci:sharded",
    "prepack": "npm run build",
    "build": "tsc -p tsconfig.json && node scripts/authority-surface.mjs && node scripts/copy-assets.mjs && node scripts/build-preparation-builtin.mjs && vite build --config vite.config.web.ts && node scripts/build-release-dependency-inventory.mjs && node scripts/build-identity.mjs",
    "build:preparation-builtin": "node scripts/build-preparation-builtin.mjs",
    "build:binary": "node scripts/build-sea.mjs",
    "release:canary": "node scripts/run-signed-release-canary.mjs",
    "verify:local-production": "node scripts/run-local-production-gate.mjs",
    "build:web": "vite build --config vite.config.web.ts",
    "dev": "tsx src/cli/index.ts",
    "dev:web": "vite --config vite.config.web.ts",
    "test": "vitest run",
    "test:serial": "vitest run --no-file-parallelism",
    "test:web": "vitest run --config vitest.config.web.ts",
    "test:ci": "node scripts/test-ci.mjs",
    "test:ci:sharded": "node scripts/test-ci-sharded.mjs",
    "test:invariants": "vitest run test/h*.test.ts --no-file-parallelism",
    "test:engineering-responsiveness": "vitest run --config vitest.config.engineering-performance.ts",
    "conformance:ecosystem": "tsx scripts/run-ecosystem-conformance.ts",
    "check:first-paint": "node scripts/check-first-paint-budget.mjs --budget-kb 353 --mobile-budget-kb 250",
    "check:first-paint:built": "node scripts/check-first-paint-budget.mjs --no-build --out-dir dist/core/web/public/next --budget-kb 353 --mobile-budget-kb 250",
    "check:docs": "node scripts/check-documentation.mjs",
    "gate": "node scripts/gate.mjs",
    "gate:full": "node scripts/gate.mjs --full",
    "ship:local": "node scripts/ship-local.mjs",
    "lint": "eslint . && npm run lint:realio-lane && npm run lint:verse-sync-io",
    "lint:realio-lane": "node scripts/check-realio-lane-membership.mjs",
    "lint:verse-sync-io": "node scripts/check-verse-sync-io.mjs",
    "typecheck": "tsc --noEmit && npm run typecheck:web",
    "typecheck:web": "tsc --noEmit -p src/web-ui/tsconfig.json"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.16",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.61.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "fast-uri": "3.1.8",
    "hono": "4.13.7",
    "ip-address": "10.7.2",
    "vite": "8.2.2",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.18",
    "qs": "6.16.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "jose": "^6.2.12",
    "marked": "18.0.10",
    "reflect-metadata": "0.2.2",
    "smol-toml": "1.9.0",
    "tar": "7.5.22",
    "web-push": "3.6.7",
    "yaml": "^2.8.1"
  },
  "bundleDependencies": [
    "@modelcontextprotocol/sdk",
    "@simplewebauthn/browser",
    "@simplewebauthn/server",
    "jose",
    "marked",
    "reflect-metadata",
    "smol-toml",
    "tar",
    "web-push",
    "yaml"
  ]
}
